@model FoodTruck.DTOs.FoodListItem

<h1>@Model.Title</h1>

<p>Total food: <strong>@Model.Price</strong></p>

@if (Model.Id == null)
{
    <p><em>@Model.Author</em></p>
}
else
{
    @foreach (var foods in Model.Title)
    {
        <partial name="_MenuItemCard" model="foods" />
    }
}
